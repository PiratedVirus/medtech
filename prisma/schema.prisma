// ===========================================
// DATABASE CONNECTION
// ===========================================
datasource db {
  provider = "postgresql"  // or "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===========================================
// ENUMS
// ===========================================
enum UserRole {
  PATIENT
  DOCTOR
  DIETICIAN
  LAB_TECH
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

// ===========================================
// CLINIC TABLE
// ===========================================
model Clinic {
  id                Int                     @id @default(autoincrement())
  name              String                  @unique
  subdomain         String?                 @unique
  domain            String?                 @unique
  address           String?
  contactInfo       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  // Relationships
  users             User[]
  specializations   ClinicSpecialization[]
}

// ===========================================
// SPECIALIZATION TABLE
// ===========================================
model ClinicSpecialization {
  id       Int    @id @default(autoincrement())
  clinicId Int
  name     String

  clinic   Clinic @relation(fields: [clinicId], references: [id])
}

// ===========================================
// USER TABLE
// ===========================================
model User {
  id          Int             @id @default(autoincrement())
  clinicId    Int?
  phoneNumber String          @unique
  email       String?         @unique
  password    String?
  name        String
  role        UserRole
  status      UserStatus      @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  clinic           Clinic?            @relation(fields: [clinicId], references: [id])
  patientProfile   PatientProfile?
  doctorProfile    DoctorProfile?
  labTechProfile   LabTechProfile?
  dieticianProfile  DieticianProfile?

  // If you want a single relation array for all appointments, you can keep this:
  // appointments      Appointment[]    // But ensure it does not conflict with the specialized relations below

  // Distinct relations for a patient's appointments vs. a doctor's appointments
  patientAppointments Appointment[] @relation("Patient")
  doctorAppointments  Appointment[] @relation("Doctor")
}

// ===========================================
// PATIENT PROFILE
// ===========================================
model PatientProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  age              Int
  weight           Float?
  height           Float?
  gender           String
  bloodGroup       String?
  allergies        String?
  medicalHistory   String?
  emergencyContact String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id])
}

// ===========================================
// DOCTOR PROFILE
// ===========================================
model DoctorProfile {
  id                Int                  @id @default(autoincrement())
  userId            Int                  @unique
  specialty         String
  yearsOfExperience Int?
  licenseNumber     String?              @unique
  consultationFee   Int                  // Fee per consultation
  rating            Float?               // Average rating
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user              User                 @relation(fields: [userId], references: [id])
  availability      DoctorAvailability[]
}
// ===========================================
// DIE PROFILE
// ===========================================
model DieticianProfile {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  specialty         String?
  yearsOfExperience Int?
  certifications    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relation
  user              User      @relation(fields: [userId], references: [id])
  availability      DieticianAvailability[]
}

// ===========================================
// LAB TECH PROFILE
// ===========================================
model LabTechProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  specialization  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
}

// ===========================================
// DOCTOR AVAILABILITY
// ===========================================
model DoctorAvailability {
  id         Int            @id @default(autoincrement())
  doctorId   Int
  date       DateTime         // e.g. "Monday"
  startTime  String         // e.g. "09:00 AM"
  endTime    String         // e.g. "05:00 PM"
  status     String         // e.g. "Available", "Booked"
  doctor     DoctorProfile  @relation(fields: [doctorId], references: [id])
  appointments  Appointment[] 
}

model DieticianAvailability {
  id           Int              @id @default(autoincrement())
  dieticianId  Int
  dayOfWeek    String
  startTime    String
  endTime      String

  // Relation
  dietician    DieticianProfile @relation(fields: [dieticianId], references: [id])
}

// ===========================================
// CONSULTATION TYPE
// ===========================================
model ConsultationType {
  id            Int           @id @default(autoincrement())
  type          String        // e.g. "Video" or "Physical"

  // Back relation for appointments
  appointments  Appointment[]
}

// ===========================================
// APPOINTMENT BOOKING SYSTEM
// ===========================================
model Appointment {
  id                   Int               @id @default(autoincrement())
  patientId            Int
  doctorId             Int
  consultationTypeId   Int
  doctorAvailabilityId Int

  // Optional fields for booking details
  appointmentFor       String?          // e.g. "self" or "other"
  fullName             String?          // If booking for someone else, store their name
  mobile               String?          // If booking for someone else
  email                String?          // If booking for someone else

  // You can store the date/time from the availability as well (to preserve historical data)
  appointmentDate      DateTime?

  status               String           // e.g. "Scheduled", "Completed", "Cancelled"
  createdAt            DateTime?         @default(now())
  updatedAt            DateTime?        @updatedAt

  // Relations
  patient              User              @relation("Patient", fields: [patientId], references: [id])
  doctor               User              @relation("Doctor", fields: [doctorId], references: [id])
  consultationType     ConsultationType  @relation(fields: [consultationTypeId], references: [id])
  doctorAvailability   DoctorAvailability @relation(fields: [doctorAvailabilityId], references: [id])
}

// ===========================================
// MEDICINE TABLE
// ===========================================
model Medicine {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  category    String?
  description String?
  price       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===========================================
// COMPLAINTS TABLE
// ===========================================
model Complaint {
  id          Int      @id @default(autoincrement())
  text        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}