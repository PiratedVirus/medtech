generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clinic {
  id              Int                    @id @default(autoincrement())
  name            String                 @unique
  subdomain       String?                @unique
  domain          String?                @unique
  address         String?
  contactInfo     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  specializations ClinicSpecialization[]
  users           User[]

  @@index([deletedAt])
}

model ClinicSpecialization {
  id        Int       @id @default(autoincrement())
  clinicId  Int
  name      String
  deletedAt DateTime?
  clinic    Clinic    @relation(fields: [clinicId], references: [id])

  @@index([deletedAt])
}

model User {
  id                  Int               @id @default(autoincrement())
  clinicId            Int?
  phoneNumber         String
  email               String?           @unique
  password            String?
  name                String
  role                UserRole
  status              UserStatus        @default(ACTIVE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  userProfilePicture  String?
  doctorCode          String?
  doctorAppointments  Appointment[]     @relation("Doctor")
  patientAppointments Appointment[]     @relation("Patient")
  dieticianProfile    DieticianProfile?
  doctorProfile       DoctorProfile?
  healthMetrics       HealthMetric[]
  labTechBookings     LabBooking[]      @relation("LabTech")
  labPatientBookings  LabBooking[]      @relation("LabPatient")
  labTechProfile      LabTechProfile?
  patientProfile      PatientProfile?
  clinic              Clinic?           @relation(fields: [clinicId], references: [id])

  @@unique([phoneNumber, deletedAt])
  @@index([deletedAt])
}

model PatientProfile {
  id               Int                   @id @default(autoincrement())
  userId           Int                   @unique
  subscriptionId   Int?
  planId           Int?
  age              Int
  weight           Float?
  height           Float?
  gender           String
  bloodGroup       String?
  allergies        String?
  medicalHistory   String?
  emergencyContact String?
  dateOfBirth      DateTime?             @db.Date
  address          String?
  profilePicture   String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  user             User                  @relation(fields: [userId], references: [id])
  planTrackers     SubscriptionTracker[]

  @@index([deletedAt])
}

model DoctorProfile {
  id                Int                  @id @default(autoincrement())
  userId            Int                  @unique
  specialty         String
  yearsOfExperience Int?
  meetingRoomLink   String?
  ownerToken1       String?
  ownerToken2       String?
  licenseNumber     String?              @unique
  consultationFee   Int
  rating            Float?
  type              String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  extraInfo         String?
  isDietician       Boolean?
  doctorCode        String?              @unique
  availability      DoctorAvailability[]
  user              User                 @relation(fields: [userId], references: [id])

  @@index([deletedAt])
}

model DieticianProfile {
  id                Int                     @id @default(autoincrement())
  userId            Int                     @unique
  specialty         String?
  yearsOfExperience Int?
  certifications    String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  availability      DieticianAvailability[]
  user              User                    @relation(fields: [userId], references: [id])

  @@index([deletedAt])
}

model LabTechProfile {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  specialization String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id])

  @@index([deletedAt])
}

model DoctorAvailability {
  id           Int           @id @default(autoincrement())
  doctorId     Int
  date         DateTime      @db.Date
  startTime    String
  endTime      String
  status       String
  deletedAt    DateTime?
  appointments Appointment[]
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([deletedAt])
}

model DieticianAvailability {
  id          Int              @id @default(autoincrement())
  dieticianId Int
  dayOfWeek   String
  startTime   String
  endTime     String
  deletedAt   DateTime?
  dietician   DieticianProfile @relation(fields: [dieticianId], references: [id])

  @@index([deletedAt])
}

model Appointment {
  id                   Int                  @id @default(autoincrement())
  patientId            Int
  doctorId             Int
  consultationType     String
  doctorAvailabilityId Int
  prescriptionLink     String?
  appointmentFor       String?
  fullName             String?
  mobile               String?
  email                String?
  isDietician          Boolean?
  appointmentDate      DateTime?            @db.Date
  appointmentLink      String?
  subscriptionId       Int?
  status               String
  createdAt            DateTime?            @default(now())
  updatedAt            DateTime?            @updatedAt
  deletedAt            DateTime?
  doctorAvailability   DoctorAvailability   @relation(fields: [doctorAvailabilityId], references: [id])
  doctor               User                 @relation("Doctor", fields: [doctorId], references: [id])
  patient              User                 @relation("Patient", fields: [patientId], references: [id])
  subscriptionTracker  SubscriptionTracker? @relation(fields: [subscriptionId], references: [subscriptionId])
  payment              Payment?             @relation("AppointmentPayment")

  @@index([deletedAt])
  @@index([patientId, isDietician])
}

model Medicine {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  category    String?
  description String?
  price       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model Complaint {
  id        Int       @id @default(autoincrement())
  text      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model Payment {
  id                Int                  @id @default(autoincrement())
  appointmentId     Int?                 @unique
  labBookingId      Int?                 @unique
  subscriptionId    Int?                 @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Int
  currency          String               @default("INR")
  paymentStatus     String
  paymentMethod     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime?            @updatedAt
  deletedAt         DateTime?
  appointment       Appointment?         @relation("AppointmentPayment", fields: [appointmentId], references: [id])
  labBooking        LabBooking?          @relation("LabBookingPayment", fields: [labBookingId], references: [id])
  subscription      SubscriptionTracker? @relation("SubscriptionPayment", fields: [subscriptionId], references: [subscriptionId])

  @@index([deletedAt])
}

model LabPackage {
  id                   Int          @id @default(autoincrement())
  name                 String       @unique
  shortDescription     String?
  description          String?
  price                Int
  parameters           Json?
  criticalRequirements String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
  isLabPackage         Boolean      @default(false)
  labBookings          LabBooking[]

  @@index([deletedAt])
}

model LabBooking {
  id             Int        @id @default(autoincrement())
  patientId      Int
  labTechId      Int?
  labPackageId   Int
  appointmentFor String?
  fullName       String?
  mobile         String?
  email          String?
  address        String?
  paymentOption  String?
  status         String
  labDate        DateTime   @db.Date
  labResult      String[]   @default([])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  labPackage     LabPackage @relation(fields: [labPackageId], references: [id])
  labTech        User?      @relation("LabTech", fields: [labTechId], references: [id])
  patient        User       @relation("LabPatient", fields: [patientId], references: [id])
  payment        Payment?   @relation("LabBookingPayment")

  @@index([deletedAt])
}

model Plan {
  id                 Int                   @id @default(autoincrement())
  name               String
  duration           String
  price              Decimal?              @db.Decimal(10, 2)
  discountPercentage Int?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  planFeatures       PlanFeature[]
  planTrackers       SubscriptionTracker[]

  @@index([deletedAt])
}

model PlanFeature {
  id                     Int       @id @default(autoincrement())
  planId                 Int
  featureName            String
  occurrencesPerInterval Int?
  intervalInMonths       Int?
  parameters             String?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  plan                   Plan      @relation(fields: [planId], references: [id])

  @@index([deletedAt])
}

model SubscriptionTracker {
  subscriptionId                   Int            @id @default(autoincrement())
  patientId                        Int
  planId                           Int
  doctorConsultationDates          String[]       @default([])
  dieticianConsultationDates       String[]       @default([])
  labTestsDates                    String[]       @default([])
  ophthalmologistConsultationDates String[]       @default([])
  usedMedicines                    String[]       @default([])
  razorpayOrderId                  String?
  razorpayPaymentId                String?
  paymentStatus                    String?        @default("PENDING")
  startDate                        DateTime       @default(now()) @db.Date
  endDate                          DateTime?      @db.Date
  isActive                         Boolean        @default(true)
  createdAt                        DateTime       @default(now())
  updatedAt                        DateTime       @updatedAt
  deletedAt                        DateTime?
  appointments                     Appointment[]
  payments                         Payment?       @relation("SubscriptionPayment")
  user                             PatientProfile @relation(fields: [patientId], references: [id])
  plan                             Plan           @relation(fields: [planId], references: [id])

  @@index([deletedAt])
}

model HealthMetric {
  id         Int       @id @default(autoincrement())
  userId     Int
  metricName String
  reading    Float
  recordedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id])

  @@index([deletedAt])
  @@index([userId])
}

enum UserRole {
  PATIENT
  DOCTOR
  DIETICIAN
  LAB_TECH
  ADMIN
  SUPER_ADMIN
  NOT_SET
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}
