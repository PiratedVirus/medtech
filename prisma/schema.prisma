generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clinic {
  id              Int                    @id @default(autoincrement())
  name            String                 @unique
  subdomain       String?                @unique
  domain          String?                @unique
  address         String?
  contactInfo     String?
  logo            String?
  timings         String?
  subtitle        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  specializations ClinicSpecialization[]
  users           User[]

  @@index([deletedAt])
}

model ClinicSpecialization {
  id        Int       @id @default(autoincrement())
  clinicId  Int
  name      String
  deletedAt DateTime?
  clinic    Clinic    @relation(fields: [clinicId], references: [id])

  @@index([deletedAt])
}

model User {
  id                  Int               @id @default(autoincrement())
  clinicId            Int?
  phoneNumber         String
  email               String?           @unique
  password            String?
  name                String
  role                UserRole
  status              UserStatus        @default(ACTIVE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  userProfilePicture  String?
  doctorCode          String?
  doctorAppointments  Appointment[]     @relation("Doctor")
  patientAppointments Appointment[]     @relation("Patient")
  doctorPrescriptions Prescription[]    @relation("DoctorPrescriptions")
  patientPrescriptions Prescription[]   @relation("PatientPrescriptions")
  doctorTemplates     PrescriptionTemplate[] @relation("DoctorTemplates")
  dieticianProfile    DieticianProfile?
  doctorProfile       DoctorProfile?
  healthMetrics       HealthMetric[]
  patientPills        PatientPill[]
  labTechBookings     LabBooking[]      @relation("LabTech")
  labPatientBookings  LabBooking[]      @relation("LabPatient")
  labTechProfile      LabTechProfile?
  patientProfile      PatientProfile?
  clinic              Clinic?           @relation(fields: [clinicId], references: [id])
  phlebotomistProfile Phlebotomist?
  labAssignments      LabAssignment[]   @relation("PatientLabAssignment")
  testResultsReported TestResult[]      @relation("TestResultReporter")

  @@unique([phoneNumber, deletedAt])
  @@index([deletedAt])
}

model PatientProfile {
  id               Int                   @id @default(autoincrement())
  userId           Int                   @unique
  subscriptionId   Int?
  planId           Int?
  age              Int
  weight           Float?
  height           Float?
  gender           String
  bloodGroup       String?
  allergies        String?
  medicalHistory   String?
  emergencyContact String?
  dateOfBirth      DateTime?             @db.Date
  address          String?
  profilePicture   String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  user             User                  @relation(fields: [userId], references: [id])
  planTrackers     SubscriptionTracker[]

  @@index([deletedAt])
}

model DoctorProfile {
  id                Int                  @id @default(autoincrement())
  userId            Int                  @unique
  specialty         String
  yearsOfExperience Int?
  meetingRoomLink   String?
  ownerToken1       String?
  ownerToken2       String?
  licenseNumber     String?              @unique
  consultationFee   Int
  rating            Float?
  type              String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  extraInfo         String?
  isDietician       Boolean?
  doctorCode        String?              @unique
  availability      DoctorAvailability[]
  user              User                 @relation(fields: [userId], references: [id])

  @@index([deletedAt])
}

model DieticianProfile {
  id                Int                     @id @default(autoincrement())
  userId            Int                     @unique
  specialty         String?
  yearsOfExperience Int?
  certifications    String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  availability      DieticianAvailability[]
  user              User                    @relation(fields: [userId], references: [id])

  @@index([deletedAt])
}

model LabTechProfile {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  specialization String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id])

  @@index([deletedAt])
}

model DoctorAvailability {
  id           Int           @id @default(autoincrement())
  userId       Int
  date         DateTime      @db.Date
  startTime    String
  endTime      String
  status       String
  deletedAt    DateTime?
  appointments Appointment[]
  doctor       DoctorProfile @relation(fields: [userId], references: [userId])

  @@index([deletedAt])
}

model DieticianAvailability {
  id          Int              @id @default(autoincrement())
  dieticianId Int
  dayOfWeek   String
  startTime   String
  endTime     String
  deletedAt   DateTime?
  dietician   DieticianProfile @relation(fields: [dieticianId], references: [id])

  @@index([deletedAt])
}

model Appointment {
  id                   Int                  @id @default(autoincrement())
  patientId            Int
  userId               Int
  consultationType     String
  doctorAvailabilityId Int
  prescriptionLink     String?
  appointmentFor       String?
  fullName             String?
  mobile               String?
  email                String?
  isDietician          Boolean?
  appointmentDate      DateTime?            @db.Date
  appointmentLink      String?
  subscriptionId       Int?
  status               String
  doctorNotes          String?
  createdAt            DateTime?            @default(now())
  updatedAt            DateTime?            @updatedAt
  deletedAt            DateTime?
  doctorAvailability   DoctorAvailability   @relation(fields: [doctorAvailabilityId], references: [id])
  doctor               User                 @relation("Doctor", fields: [userId], references: [id])
  patient              User                 @relation("Patient", fields: [patientId], references: [id])
  subscriptionTracker  SubscriptionTracker? @relation(fields: [subscriptionId], references: [subscriptionId])
  payment              Payment?             @relation("AppointmentPayment")
  prescription         Prescription?
  labAssignments       LabAssignment[]
  appointmentReports   AppointmentReport[]

  @@index([deletedAt])
  @@index([patientId, isDietician])
}

model Medicine {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  category    String?
  description String?
  price       Int
  frequency   String[]  @default([]) // Common frequencies for this medicine
  medicineTime String[] @default([]) // Common times for this medicine
  duration    String[]  @default([]) // Common durations for this medicine
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model Complaint {
  id        Int       @id @default(autoincrement())
  text      String    @unique
  category  String?   // "Diabetes", "Fever", "Cardiac", etc.
  severity  ComplaintSeverity @default(MODERATE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([category])
}

model Payment {
  id                Int                  @id @default(autoincrement())
  appointmentId     Int?                 @unique
  labBookingId      Int?                 @unique
  subscriptionId    Int?                 @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  amount            Int
  currency          String               @default("INR")
  paymentStatus     String
  paymentMethod     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime?            @updatedAt
  deletedAt         DateTime?
  appointment       Appointment?         @relation("AppointmentPayment", fields: [appointmentId], references: [id])
  labBooking        LabBooking?          @relation("LabBookingPayment", fields: [labBookingId], references: [id])
  subscription      SubscriptionTracker? @relation("SubscriptionPayment", fields: [subscriptionId], references: [subscriptionId])

  @@index([deletedAt])
}

model LabPackage {
  id                   Int          @id @default(autoincrement())
  name                 String       @unique
  shortDescription     String?
  description          String?
  price                Int
  parameters           Json?
  criticalRequirements String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
  isLabPackage         Boolean      @default(false)
  labBookings          LabBooking[]

  @@index([deletedAt])
}

model LabBooking {
  id                Int        @id @default(autoincrement())
  patientId         Int
  labTechId         Int?
  labPackageId      Int
  labAssignmentId   Int?       // Link to pathology assignment
  appointmentFor    String?
  fullName          String?
  mobile            String?
  email             String?
  address           String?
  paymentOption     String?
  status            LabAssignmentStatus @default(PENDING) // Single status for entire workflow
  labDate           DateTime   @db.Date
  labResult         String[]   @default([])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?
  labPackage        LabPackage @relation(fields: [labPackageId], references: [id])
  labTech           User?      @relation("LabTech", fields: [labTechId], references: [id])
  patient           User       @relation("LabPatient", fields: [patientId], references: [id])
  payment           Payment?   @relation("LabBookingPayment")
  labAssignments    LabAssignment[]

  @@index([deletedAt])
  @@index([labAssignmentId])
}

model Plan {
  id                 Int                   @id @default(autoincrement())
  name               String
  duration           String
  price              Decimal?              @db.Decimal(10, 2)
  discountPercentage Int?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  planFeatures       PlanFeature[]
  planTrackers       SubscriptionTracker[]

  @@index([deletedAt])
}

model PlanFeature {
  id                     Int       @id @default(autoincrement())
  planId                 Int
  featureName            String
  occurrencesPerInterval Int?
  intervalInMonths       Int?
  parameters             String?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  plan                   Plan      @relation(fields: [planId], references: [id])

  @@index([deletedAt])
}

model SubscriptionTracker {
  subscriptionId                   Int            @id @default(autoincrement())
  patientId                        Int
  planId                           Int
  doctorConsultationDates          String[]       @default([])
  dieticianConsultationDates       String[]       @default([])
  labTestsDates                    String[]       @default([])
  ophthalmologistConsultationDates String[]       @default([])
  usedMedicines                    String[]       @default([])
  razorpayOrderId                  String?
  razorpayPaymentId                String?
  paymentStatus                    String?        @default("PENDING")
  startDate                        DateTime       @default(now()) @db.Date
  endDate                          DateTime?      @db.Date
  isActive                         Boolean        @default(true)
  createdAt                        DateTime       @default(now())
  updatedAt                        DateTime       @updatedAt
  deletedAt                        DateTime?
  appointments                     Appointment[]
  payments                         Payment?       @relation("SubscriptionPayment")
  user                             PatientProfile @relation(fields: [patientId], references: [id])
  plan                             Plan           @relation(fields: [planId], references: [id])

  @@index([deletedAt])
}

model HealthMetric {
  id         Int       @id @default(autoincrement())
  userId     Int
  metricName String
  reading    Float
  recordedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id])

  @@index([deletedAt])
  @@index([userId])
}

// Simple key-value pills shown on patient overview (e.g., Blood Pressure, Heart Rate)
model PatientPill {
  id        Int      @id @default(autoincrement())
  userId    Int
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  user      User     @relation(fields: [userId], references: [id])

  @@index([deletedAt])
  @@index([userId])
}

enum UserRole {
  PATIENT
  DOCTOR
  DIETICIAN
  LAB_TECH
  PATHOLOGY
  PHLEBOTOMIST
  ADMIN
  SUPER_ADMIN
  NOT_SET
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

// New models for prescription system
model Prescription {
  id                    Int                    @id @default(autoincrement())
  appointmentId         Int                    @unique
  patientId             Int
  doctorId              Int
  prescriptionNumber    String                 @unique
  complaints            PrescriptionComplaint[]
  vitals                PrescriptionVitals?
  history               PrescriptionHistory?
  systemicExamination   PrescriptionSystemicExamination?
  medicines             PrescriptionMedicine[]
  advice                String?
  testsRequested        String?
  nextVisitDate         DateTime?
  nextVisitType         String? // "days", "weeks", "months"
  nextVisitValue        Int?
  isTemplate            Boolean                @default(false)
  templateName          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  
  appointment           Appointment            @relation(fields: [appointmentId], references: [id])
  patient               User                   @relation("PatientPrescriptions", fields: [patientId], references: [id])
  doctor                User                   @relation("DoctorPrescriptions", fields: [doctorId], references: [id])

  @@index([deletedAt])
  @@index([patientId])
  @@index([doctorId])
}

model PrescriptionComplaint {
  id             Int           @id @default(autoincrement())
  prescriptionId Int
  complaintText  String
  severity       ComplaintSeverity @default(MODERATE)
  daysSince      Int?
  isFlagged      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  prescription   Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model PrescriptionVitals {
  id             Int           @id @default(autoincrement())
  prescriptionId Int           @unique
  bloodPressure  String?       // "120/80"
  pulse          Int?
  height         Float?        // in cm
  weight         Float?        // in kg
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  prescription   Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PrescriptionHistory {
  id                Int           @id @default(autoincrement())
  prescriptionId    Int           @unique
  allergies         String?
  personalHistory   String?
  pastMedicalHistory String?
  familyHistory     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  prescription      Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PrescriptionSystemicExamination {
  id             Int           @id @default(autoincrement())
  prescriptionId Int           @unique
  general        String?
  cvs            String?       // Cardiovascular System
  rs             String?       // Respiratory System
  cns            String?       // Central Nervous System
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  prescription   Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model PrescriptionMedicine {
  id             Int           @id @default(autoincrement())
  prescriptionId Int
  medicineName   String
  frequency      String?       // "Once daily", "Twice daily", etc.
  medicineTime   String?       // "Morning", "Evening", "Before meals", etc.
  duration       String?       // "7 days", "15 days", etc.
  quantity       Int?
  instructions   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  prescription   Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

model PrescriptionTemplate {
  id                    Int                    @id @default(autoincrement())
  doctorId              Int
  templateName          String
  templateDescription   String?
  complaints            TemplateComplaint[]
  medicines             TemplateMedicine[]
  advice                String?
  testsRequested        String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  
  doctor                User                   @relation("DoctorTemplates", fields: [doctorId], references: [id])

  @@index([deletedAt])
  @@index([doctorId])
}

model TemplateComplaint {
  id                    Int                   @id @default(autoincrement())
  templateId            Int
  complaintText         String
  severity              ComplaintSeverity     @default(MODERATE)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  
  template              PrescriptionTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model TemplateMedicine {
  id                    Int                   @id @default(autoincrement())
  templateId            Int
  medicineName          String
  frequency             String?
  medicineTime          String?
  duration              String?
  quantity              Int?
  instructions          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  
  template              PrescriptionTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}



// Common values for type-ahead
model CommonValue {
  id        Int       @id @default(autoincrement())
  type      String    // "frequency", "medicineTime", "duration", "advice", "tests"
  value     String
  category  String?   // For categorization
  usageCount Int      @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([type, value])
  @@index([deletedAt])
  @@index([type, category])
}

enum ComplaintSeverity {
  PERFECT
  GOOD
  MODERATE
  RISK
  CRITICAL
}

// Pathology related models
model Phlebotomist {
  id                Int                    @id @default(autoincrement())
  userId            Int                    @unique
  employeeId        String                 @unique
  specialization    String?
  isAvailable       Boolean                @default(true)
  currentLocation   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  user              User                   @relation(fields: [userId], references: [id])
  labAssignments    LabAssignment[]

  @@index([deletedAt])
}

model PathologyLab {
  id                Int                    @id @default(autoincrement())
  name              String
  address           String
  contactNumber     String
  email             String?
  licenseNumber     String                 @unique
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  labAssignments    LabAssignment[]

  @@index([deletedAt])
}

model LabAssignment {
  id                Int                    @id @default(autoincrement())
  patientId         Int
  phlebotomistId    Int
  labId             Int
  labBookingId      Int?                   // Link to patient lab booking
  appointmentId     Int?
  assignedDate      DateTime               @db.Date
  assignedTime      String
  status            LabAssignmentStatus    @default(PENDING)
  sampleCollected   Boolean                @default(false)
  sampleCollectedAt DateTime?
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  patient           User                   @relation("PatientLabAssignment", fields: [patientId], references: [id])
  phlebotomist      Phlebotomist           @relation(fields: [phlebotomistId], references: [id])
  lab               PathologyLab           @relation(fields: [labId], references: [id])
  appointment       Appointment?           @relation(fields: [appointmentId], references: [id])
  labBooking        LabBooking?            @relation(fields: [labBookingId], references: [id])
  testResults       TestResult[]

  @@index([deletedAt])
  @@index([patientId])
  @@index([phlebotomistId])
  @@index([status])
  @@index([labBookingId])
}

model LabTest {
  id                Int                    @id @default(autoincrement())
  name              String
  code              String                 @unique
  description       String?
  parameters        Json?                  // Array of test parameters
  normalRange       Json?                  // Normal range values
  unit              String?
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  testResults       TestResult[]

  @@index([deletedAt])
}

model TestResult {
  id                Int                    @id @default(autoincrement())
  labAssignmentId   Int
  labTestId         Int
  result            String?
  unit              String?
  normalRange       String?
  isAbnormal        Boolean                @default(false)
  remarks           String?
  reportedAt        DateTime?
  reportedBy        Int?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  labAssignment     LabAssignment          @relation(fields: [labAssignmentId], references: [id])
  labTest           LabTest                @relation(fields: [labTestId], references: [id])
  reportedByUser    User?                  @relation("TestResultReporter", fields: [reportedBy], references: [id])

  @@index([deletedAt])
  @@index([labAssignmentId])
  @@index([labTestId])
}

model AppointmentReport {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  fileName      String
  fileUrl       String
  fileSize      Int?
  mimeType      String?
  uploadedAt    DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@index([deletedAt])
}

enum LabAssignmentStatus {
  PENDING
  ASSIGNED
  PHLEBOTOMIST_LEFT
  SAMPLE_COLLECTED
  IN_LAB
  ANALYZING
  COMPLETED
  CANCELLED
}
