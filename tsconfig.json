{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/patients/*": ["./components/patients/*"],
      "@/doctors/*": ["./components/doctors/*"],
      "@/home/*": ["./components/home/*"],
      "@/appointment-book/*": ["./components/patients/appointments/booking/*"],
      "@/appointment-view/*": ["./components/patients/appointments/view/*"],

      "@/custom/*": ["./components/ui/custom/*"],
      "@/app/*": ["./app/*"]
    },
    "types": [],
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.cjs",
    "app/api/doctor/stats/route.js",
    "app/api/doctor/appointments/upcoming/route.js"
  ],
  "exclude": ["node_modules"]
}
