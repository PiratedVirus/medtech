{
  "name": "caredb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS='--inspect' next dev",
    "build": "cross-env NODE_ENV=production prisma generate && next build --no-lint",
    "start": "cross-env NODE_ENV=production next start",
    "storybook": "concurrently \"npm run watch:storybook\" \"npm run watch:build:css\"",
    "watch:storybook": "storybook dev -p 6006",
    "watch:build:css": "tailwindcss -i ./app/globals.css -o ./styles/globals.css",
    "build-storybook": "storybook build",
    "migrate:dev": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "generate:prisma": "prisma generate",
    "deploy": "npm run migrate:prod && npm run generate:prisma && npm run build && npm run start",
    "seed": "node prisma/seeds/main.js",
    "seed:fresh": "node prisma/seeds/main.js --start-fresh",
    "seed:v2": "node prisma/seeds/v2/main.js",
    "seed:v2:fresh": "node prisma/seeds/v2/main.js --start-fresh",
    "fix:missing-data": "node prisma/seeds/v2/fixMissingData.js",
    "fix:robust": "node prisma/seeds/v2/runRobustFix.js",
    "ensure:complete-data": "node prisma/seeds/v2/ensureCompleteData.js"
  },
